<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CADBFA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1A365D"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:elevation="4dp">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="centerInside"
                android:src="@drawable/logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Excess Baggage Calculator"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>


        <EditText
            android:id="@+id/etBaggageWeight"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:hint="  Enter baggage weight (kg)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Ticket Class:"
            android:textColor="#1A365D"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />


        <RadioGroup
            android:id="@+id/rgTicketClass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbEconomy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Economy (20kg)"
                android:textColor="#2D3748" />

            <RadioButton
                android:id="@+id/rbBusiness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Business (40kg)"
                android:textColor="#2D3748"
                android:layout_marginStart="24dp" />
        </RadioGroup>


        <EditText
            android:id="@+id/etRatePerKg"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#FFFFFF"
            android:hint="  Enter excess rate per kg (RM)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="24dp" />


        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="#2B6CB0"
            android:text="Calculate Fee"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Results Breakdown"
                    android:textColor="#1A365D"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvExcessWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Excess Baggage Weight: 0 kg"
                    android:textColor="#2D3748"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvExcessCharge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Excess Baggage Charge: RM 0.00"
                    android:textColor="#2D3748"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />


                <TextView
                    android:id="@+id/tvTotalPayable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total Amount Payable: RM 0.00"
                    android:textColor="#C53030"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnReset"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="2dp"
                    android:backgroundTint="#718096"
                    android:text="Reset Fields"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>